{
  "name": "waldo-react-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:start-server": "cd ../waldo-rails-app && RAILS_ENV=test rails server -p 3001 & sleep 3",
    "test:cleanup": "lsof -ti:3001 | xargs kill -9 2>/dev/null || true",
    "test:components": "vitest run --config vitest.config.components.js src/tests/components/",
    "test:components:file": "vitest run --config vitest.config.components.js",
    "test:integration": "trap 'npm run test:cleanup' EXIT && npm run test:start-server && vitest run --config vitest.config.integration.js src/tests/integration/",
    "test:integration:file": "trap 'npm run test:cleanup' EXIT && npm run test:start-server && vitest run --config vitest.config.integration.js",
    "test:all": "npm run test:components && npm run test:integration",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.1",
    "tailwindcss": "^4.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^4.4.1",
    "daisyui": "^5.0.35",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
